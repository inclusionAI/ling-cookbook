# Copy to .env in this skill root. .env is gitignored; secrets stay local.
# scripts/configure.py creates the file safely and never overwrites it.
LING_UI_DESIGN_API_KEY=
LING_UI_DESIGN_API_BASE=https://openrouter.ai/api/v1/

LING_UI_DESIGN_IMAGE_MODEL=inclusionai/ming-image-0.1-design
LING_UI_DESIGN_IMAGE_SIZE=2048x2048
LING_UI_DESIGN_IMAGE_TIMEOUT=600

LING_UI_DESIGN_DECOMPOSE_MODEL=inclusionai/ming-image-0.1-design-layer
LING_UI_DESIGN_DECOMPOSE_SIZE=auto
LING_UI_DESIGN_DECOMPOSE_STEPS=14
LING_UI_DESIGN_DECOMPOSE_SEED=42
LING_UI_DESIGN_DECOMPOSE_TIMEOUT=600
